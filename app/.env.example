# Supabase → Project Settings → API (use the anon/publishable key, never service_role)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# SHA-256 of the /board admin password. Generate with:
#   printf '%s' 'your-password' | shasum -a 256
VITE_BOARD_PASSWORD_HASH=
